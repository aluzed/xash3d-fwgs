#! /usr/bin/env python
# encoding: utf-8

SHADER_STAGES = ['vert', 'frag', 'comp']

def options(opt):
	pass

def configure(conf):
	# vendored headers keep the build reproducible, the loader itself is
	# opened by the engine (SDL_Vulkan_LoadLibrary) and never linked
	headers = conf.path.find_node('../../3rdparty/Vulkan-Headers/include/vulkan/vulkan.h')
	if not headers:
		conf.fatal('3rdparty/Vulkan-Headers is missing, run: git submodule update --init 3rdparty/Vulkan-Headers')

	conf.find_program('glslc', var = 'GLSLC')

def build(bld):
	libs = [ 'ref_common', 'engine_includes', 'werror', 'yy_thunks', 'public', 'M' ]

	# SPIR-V embedded as C arrays: shaders/<name>.<stage> -> shaders/<name>.<stage>.inc
	includes = bld.path.ant_glob('shaders/*.h shaders/*.glsl')
	for stage in SHADER_STAGES:
		for src in bld.path.ant_glob('shaders/*.' + stage):
			tgt = bld.path.find_or_declare('shaders/' + src.name + '.inc')
			bld(rule = '${GLSLC} --target-env=vulkan1.3 -O -mfmt=c ${SRC} -o ${TGT}',
				source = src, target = tgt)
			for inc in includes:
				bld.add_manual_dependency(src, inc)

	# gccdeps needs the generated headers to exist before the C files that
	# include them are scanned: a new group runs after the shader tasks
	bld.add_group()

	bld.shlib(source = bld.path.ant_glob('*.c'),
		target = 'ref_vk',
		includes = [ '.', '../../3rdparty/Vulkan-Headers/include' ],
		features = 'format',
		use = libs,
		defines = [ 'REF_DLL=1' ],
		install_path = bld.env.LIBDIR)
