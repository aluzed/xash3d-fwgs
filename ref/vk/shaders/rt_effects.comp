#version 460
#extension GL_GOOGLE_include_directive : require

// r_vk_quality rt: what the rays add to the HDR scene, per pixel of the view.
// The pixel's surface is found again with a ray from the eye (its depth
// must be the raster's, else the pixel shows something left out of the
// scene, a sprite or a particle, and stays as drawn), then:
//
//   shadows      the light a lightmap texel has from the sun or a dynamic
//                light, when an entity stands in between, is taken out of
//                it: through R_BuildLightMap's gamma table, back to the
//                texel the pixel was drawn with. Studio models lit by the
//                sky lose their directional light where the world or
//                another entity hides the sun.
//   occlusion    one ray in the normal's hemisphere, accumulated over the
//                frames where the surface stays (rt_ao_blur.comp filters it)
//   reflections  water, glass (kRenderTransTexture brush entities) and
//                materials with reflective 1 mirror what a ray finds,
//                lit as drawn (texture times lightmap or vertex colour),
//                or the skybox
//
// inputs: HDR scene, depth, previous occlusion history
// outputs: 0 HDR scene, 1 occlusion history (occlusion, frames, eye distance)

layout( local_size_x = 8, local_size_y = 8 ) in;

#include "rtfx_common.glsl"

layout( set = 1, binding = 2, rgba16f ) uniform image2D outputs[2];

#define SHADE_LAMBERT 1.4953241 // vk_studio.c R_StudioLighting
#define CASTERS ( RT_MASK_BRUSH | RT_MASK_MODELS )

// a hit lit the way the raster draws it
vec3 ShadeHit( rt_scene_r scene, rtfx_params_r p, rt_hit_s hit )
{
	vec3 albedo = hit.texture > 0 ? textureLod( textures[nonuniformEXT( hit.texture )], hit.uv, 0.0 ).rgb : vec3( 0.5 );

	albedo = pow( albedo, vec3( 2.2 ));

	if( hit.kind == RT_KIND_STUDIO )
		return albedo * pow( hit.color.rgb, vec3( 2.2 ));

	if(( hit.flags & RT_SURF_WATER ) != 0 || hit.lightmap <= 0 )
		return albedo;

	vec3 lm = textureLod( textures[nonuniformEXT( hit.lightmap )], hit.lightuv, 0.0 ).rgb;
	return albedo * pow( lm * p.light.y, vec3( 2.2 )) * p.light.x;
}

vec3 Reflection( rt_scene_r scene, rtfx_params_r p, vec3 origin, vec3 dir )
{
	rt_hit_s hit;
	int instance;
	float t;

	if( RTTraceSkip( tlas, scene, origin, dir, 0.0, 16384.0, BLOCKERS | RT_MASK_WATER, RT_SKIP_NONE, hit, instance, t ))
		return ShadeHit( scene, p, hit );

	return RTSky( scene, dir );
}

// water ripples a little
vec3 WaterNormal( vec3 pos, vec3 n, float time )
{
	vec2 w = vec2( sin( pos.x * 0.05 + time * 1.3 ) + sin( pos.y * 0.071 - time * 0.9 ),
		cos( pos.y * 0.06 + time * 1.1 ) + sin(( pos.x + pos.y ) * 0.043 + time * 0.7 ));

	return normalize( n + vec3( w * 0.015, 0.0 ));
}

// the mirror direction, kept off the surface
vec3 ReflectAbove( vec3 dir, vec3 rn, vec3 n )
{
	vec3 r = reflect( dir, rn );

	return dot( r, n ) < 0.01 ? normalize( r - n * ( dot( r, n ) - 0.01 )) : r;
}

float Fresnel( float f0, float cos_theta )
{
	return f0 + ( 1.0 - f0 ) * pow( 1.0 - clamp( cos_theta, 0.0, 1.0 ), 5.0 );
}

// the light taken out of a lightmapped surface, in R_BuildLightMap's 10 bit
// units; lit: what the dynamic lights give it, with their shadows
// sun_hidden: the part of the sun entities hide (rt_shadows.comp), below 0
// to find it here with one ray
vec3 BlockedLight( rt_scene_r scene, rtfx_params_r p, vec3 pos, vec3 n, int self_entity, float sun_hidden, out vec3 lit )
{
	const float to_light = 4.0 * float( scene.sky2.w ) / 256.0; // lightmap units to 10 bit light
	vec3 origin = pos + n * 0.5;
	vec3 removed = vec3( 0.0 );

	lit = vec3( 0.0 );

	// the sun: the lightmap has it where the world lets it through
	float cos_sun = dot( n, scene.sun_dir.xyz );
	if( sun_hidden >= 0.0 )
		removed += scene.sun_color.rgb * ( max( cos_sun, 0.0 ) * p.shadow.x * to_light * sun_hidden );
	else if( cos_sun > 0.0 && dot( scene.sun_color.rgb, vec3( 1.0 )) > 0.0
		&& !RTOccluded( tlas, scene, origin, scene.sun_dir.xyz, 16384.0, RT_MASK_WORLD, RT_SKIP_NONE )
		&& RTOccluded( tlas, scene, origin, scene.sun_dir.xyz, 16384.0, CASTERS, self_entity ))
		removed += scene.sun_color.rgb * ( cos_sun * p.shadow.x * to_light );

	// dynamic lights, as R_AddDynamicLights adds them
	rt_lights_r lights = rt_lights_r( scene.lights );
	for( int i = 0; i < scene.sky2.z; i++ )
	{
		rt_light_s l = lights.v[i];
		vec3 lo = l.origin_radius.xyz;
		float dist = dot( lo - pos, n );
		float rad = l.origin_radius.w - abs( dist );
		float minlight = l.color_minlight.w;

		if( rad < minlight )
			continue;

		float d = length( lo - n * dist - pos );
		if( d >= rad - minlight )
			continue;

		vec3 to = lo - origin;
		float len = length( to );
		vec3 add = ( rad - d ) * l.color_minlight.rgb * ( float( scene.sky2.w ) / 16384.0 );

		if( len < 1.0 || !RTOccluded( tlas, scene, origin, to / len, len - 1.0, BLOCKERS, l.key ))
			lit += add;
		else removed += add;
	}

	return removed;
}

// GoldSrc's light encoding: the factor that takes the texel lit by l to the one lit by l2
float TexelRatio( rt_scene_r scene, float l, float l2 )
{
	float v = RTLightToTexel( scene, l );
	return v > 1e-3 ? pow( RTLightToTexel( scene, l2 ) / v, 2.2 ) : 1.0;
}

void main()
{
	rtfx_params_r p = rtfx_params_r( pc.params );
	rt_scene_r scene = rt_scene_r( pc.scene );

	if( any( greaterThanEqual( gl_GlobalInvocationID.xy, uvec2( p.rect.zw ))))
		return;

	ivec2 pixel = ivec2( gl_GlobalInvocationID.xy ) + p.rect.xy;
	vec2 uv = ( vec2( gl_GlobalInvocationID.xy ) + 0.5 ) / vec2( p.rect.zw );
	vec3 dir = ViewRay( p, uv );
	vec4 color = texelFetch( inputs[0], pixel, 0 );
	float raster = EyeDepth( p, texelFetch( inputs[1], pixel, 0 ).r );
	int flags = p.misc.x;
	rt_hit_s hit;
	int instance;
	float t;

	imageStore( outputs[1], pixel, vec4( 1.0, 0.0, 0.0, 0.0 ));

	if( raster >= 1e8 || !RTTraceSkip( tlas, scene, p.eye.xyz, dir, 0.0, 65536.0, BLOCKERS | RT_MASK_VIEWMODEL | RT_MASK_WATER,
		RT_SKIP_NONE, hit, instance, t ))
	{
		imageStore( outputs[0], pixel, color );
		return;
	}

	rt_instance_s inst = rt_instances_r( scene.instances ).v[instance];
	float traced = t * dot( dir, p.forward.xyz );

	// drawn in front of what the rays see: sprites, particles, the view model
	if( raster < traced - 2.0 - traced * 0.01 || ( inst.flags & RT_INST_VIEWMODEL ) != 0 )
	{
		imageStore( outputs[0], pixel, color );
		return;
	}

	vec3 pos = hit.position;
	vec3 n = hit.normal;

	// lightmapped surfaces: shadows taken out of the lightmap's light, and the
	// rays' lighting (026) in place of part or all of it
	vec4 gi = ( flags & FX_GI ) != 0 ? texelFetch( inputs[3], pixel, 0 ) : vec4( 0.0 );
	vec4 soft = ( flags & FX_SOFT ) != 0 ? texelFetch( inputs[4], pixel, 0 ) : vec4( 0.0 );
	float sun_hidden = ( flags & FX_SOFT ) != 0 ? ( soft.a > 0.0 ? soft.r : 0.0 ) : -1.0;
	bool lightmapped = hit.kind == RT_KIND_BRUSH && ( hit.flags & RT_SURF_WATER ) == 0 && hit.lightmap > 0;

	if( lightmapped && (( flags & FX_SHADOWS ) != 0 || gi.a > 0.0 ))
	{
		vec3 lit, removed = BlockedLight( scene, p, pos, n, inst.entity, sun_hidden, lit );
		vec3 texel = textureLod( textures[nonuniformEXT( hit.lightmap )], hit.lightuv, 0.0 ).rgb;

		if(( flags & FX_SHADOWS ) == 0 )
			removed = vec3( 0.0 );

		vec3 albedo = vec3( 0.0 );
		if( gi.a > 0.0 && hit.texture > 0 )
			albedo = pow( textureLod( textures[nonuniformEXT( hit.texture )], hit.uv, 0.0 ).rgb, vec3( 2.2 ));

		for( int c = 0; c < 3; c++ )
		{
			float l = RTTexelToLight( scene, texel[c] );
			float l2 = max( l - removed[c], l * p.shadow.y );

			if( gi.a > 0.0 )
			{
				l2 = mix( l2, gi[c] * p.gi.y + lit[c], p.gi.x );

				// a dark texel says little of the colour under it: from the
				// texture then, lit as the lightmap pass would
				float drawn = albedo[c] * pow( RTLightToTexel( scene, l2 ) * p.light.y, 2.2 ) * p.light.x;
				color[c] = mix( drawn, color[c] * TexelRatio( scene, l, l2 ), smoothstep( 0.03, 0.12, texel[c] ));
			}
			else color[c] *= TexelRatio( scene, l, l2 );
		}
	}

	if(( flags & FX_SHADOWS ) != 0 )
	{
		float hidden = 0.0;

		if( hit.kind == RT_KIND_STUDIO && ( inst.flags & RT_INST_SKYLIT ) != 0 && dot( n, scene.sun_dir.xyz ) > 0.0 )
			hidden = sun_hidden >= 0.0 ? sun_hidden
				: RTOccluded( tlas, scene, pos + n * 1.0, scene.sun_dir.xyz, 16384.0, BLOCKERS, inst.entity ) ? 1.0 : 0.0;

		if( hidden > 0.0 )
		{
			// R_StudioLighting with the sky's light vector, then without its directional part
			float lightcos = dot( n, -scene.sun_dir.xyz );
			float k = max(( lightcos + ( SHADE_LAMBERT - 1.0 )) / SHADE_LAMBERT, 0.0 );
			float illum = clamp( inst.ambient + inst.shade - inst.shade * k, 0.0, 255.0 );
			float shadowed = clamp( max( inst.ambient, illum * p.shadow.y ), 0.0, 255.0 );

			color.rgb *= mix( 1.0, TexelRatio( scene, illum * 4.0, shadowed * 4.0 ), hidden );
		}
	}

	// for rt_gi.comp next frame: the distance, and how bright the lightmap was
	float lightmap_luma = lightmapped ? Luminance( textureLod( textures[nonuniformEXT( hit.lightmap )], hit.lightuv, 0.0 ).rgb ) : -1.0;

	if(( flags & FX_AO ) == 0 )
		imageStore( outputs[1], pixel, vec4( 1.0, 0.0, length( pos - p.eye.xyz ), lightmap_luma ));

	if(( flags & FX_AO ) != 0 )
	{
		vec2 r = Random2( pixel, p.misc.y, 0u );
		vec3 ao_dir = CosineDirection( n, r );
		float radius = p.ao.x;
		rt_hit_s ao_hit;
		int ao_inst;
		float ao_t;
		float ao = 1.0;

		if( RTTraceSkip( tlas, scene, pos + n * 0.5, ao_dir, 0.0, radius, BLOCKERS, RT_SKIP_NONE, ao_hit, ao_inst, ao_t ))
			ao = ao_t / radius;

		// the same surface in the previous frame: accumulate
		float dist = length( pos - p.eye.xyz );
		float frames = 1.0;

		bool known;
		vec3 prev_pos = RTPrevPosition( scene, inst, hit, known );
		ivec2 prev_pixel;

		if(( flags & FX_HISTORY ) != 0 && known && PrevPixel( p, prev_pos, prev_pixel ))
		{
			vec4 h = texelFetch( inputs[2], prev_pixel, 0 );

			if( h.y > 0.0 && SameSurface( p, h.z, prev_pos ))
			{
				frames = min( h.y + 1.0, 24.0 );
				ao = mix( h.x, ao, 1.0 / frames );
			}
		}

		imageStore( outputs[1], pixel, vec4( ao, frames, dist, lightmap_luma ));
	}

	if(( flags & FX_REFLECTIONS ) != 0 )
	{
		float strength = p.refl.x;

		// glass or translucent water in front of the surface: its reflection adds
		rt_hit_s glass;
		int glass_inst;
		float glass_t;
		if( RTTraceSkip( tlas, scene, p.eye.xyz, dir, 0.0, t, RT_MASK_TRANS, RT_SKIP_NONE, glass, glass_inst, glass_t ))
		{
			bool water = ( glass.flags & RT_SURF_WATER ) != 0;

			if( water || ( rt_instances_r( scene.instances ).v[glass_inst].flags & RT_INST_GLASS ) != 0 )
			{
				vec3 gn = water ? WaterNormal( glass.position, glass.normal, p.refl.y ) : glass.normal;
				float f = Fresnel( water ? 0.02 : 0.04, dot( -dir, gn ));
				color.rgb += Reflection( scene, p, glass.position + glass.normal * 0.5, ReflectAbove( dir, gn, glass.normal )) * ( f * strength );
			}
		}

		if(( hit.flags & ( RT_SURF_WATER | RT_SURF_REFLECT )) != 0 )
		{
			bool water = ( hit.flags & RT_SURF_WATER ) != 0;
			vec3 rn = water ? WaterNormal( pos, n, p.refl.y ) : n;
			float f = Fresnel( water ? 0.02 : 0.04, dot( -dir, rn ));
			vec3 r = Reflection( scene, p, pos + n * 0.5, ReflectAbove( dir, rn, n ));

			color.rgb = mix( color.rgb, r, clamp( f * strength, 0.0, 1.0 ));
		}
	}

	imageStore( outputs[0], pixel, color );
}
