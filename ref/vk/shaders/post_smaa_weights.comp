#version 450
#extension GL_GOOGLE_include_directive : require

// SMAA second pass: blending weights from the edges' shapes
//
// inputs: edges, area texture, search texture

layout( local_size_x = 8, local_size_y = 8 ) in;

#include "post_common.glsl"
#include "post_smaa_common.glsl"

layout( set = 0, binding = 1, rgba8 ) uniform writeonly image2D out_weights;

void main()
{
	ivec2 pixel;

	if( !PostPixel( pixel ))
		return;

	vec2 uv = ( vec2( pixel ) + 0.5 ) * pc.texel.xy;
	vec2 pixcoord;
	vec4 offset[3];

	SMAABlendingWeightCalculationVS( uv, pixcoord, offset );
	imageStore( out_weights, pixel, SMAABlendingWeightCalculationPS( uv, pixcoord, offset, inputs[0], inputs[1], inputs[2], vec4( 0.0 )));
}
