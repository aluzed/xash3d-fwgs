#version 450
#extension GL_GOOGLE_include_directive : require

// screen space ambient occlusion from the depth only, at half size: view
// space positions rebuilt from the eye distance (post_ssao_depth.comp) and
// the field of view, normals from the depth differences, samples in the
// normal's hemisphere. The 4x4 rotation pattern is what post_ssao_blur.comp
// averages out.
//
// params: near, far, tan(fov_x / 2), tan(fov_y / 2)
// params2: radius in world units, strength

layout( local_size_x = 8, local_size_y = 8 ) in;

#include "post_common.glsl"

layout( set = 0, binding = 1, r32f ) uniform writeonly image2D out_ao;

#define NUM_SAMPLES 12

// eye distance, 0 for the sky
float EyeDepthAt( vec2 pixel )
{
	return textureLod( inputs[0], pixel * pc.texel.xy, 0.0 ).r;
}

// pixel centre (target pixels) and eye depth to view space, y up, z forward
vec3 ViewPosition( vec2 pixel, float z )
{
	vec2 uv = ( pixel - vec2( pc.rect.xy )) / vec2( pc.rect.zw );
	return vec3(( uv.x * 2.0 - 1.0 ) * pc.params.z * z, ( 1.0 - uv.y * 2.0 ) * pc.params.w * z, z );
}

vec2 ProjectToPixel( vec3 p )
{
	vec2 ndc = vec2( p.x / ( p.z * pc.params.z ), p.y / ( p.z * pc.params.w ));
	return vec2( pc.rect.xy ) + vec2( ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5 ) * vec2( pc.rect.zw );
}

vec3 ViewPositionAt( vec2 pixel )
{
	return ViewPosition( pixel, EyeDepthAt( pixel ));
}

void main()
{
	ivec2 pixel;

	if( !PostPixel( pixel ))
		return;

	vec2 centre = vec2( pixel ) + 0.5;
	float z = EyeDepthAt( centre );

	// sky and nothing drawn
	if( z <= 0.0 )
	{
		imageStore( out_ao, pixel, vec4( 1.0 ));
		return;
	}

	vec3 p = ViewPosition( centre, z );

	// the closer neighbour on each axis: no normals bent across edges
	vec3 dx0 = p - ViewPositionAt( centre - vec2( 1.0, 0.0 ));
	vec3 dx1 = ViewPositionAt( centre + vec2( 1.0, 0.0 )) - p;
	vec3 dy0 = p - ViewPositionAt( centre - vec2( 0.0, 1.0 ));
	vec3 dy1 = ViewPositionAt( centre + vec2( 0.0, 1.0 )) - p;
	vec3 dx = abs( dx0.z ) < abs( dx1.z ) ? dx0 : dx1;
	vec3 dy = abs( dy0.z ) < abs( dy1.z ) ? dy0 : dy1;
	vec3 n = normalize( cross( dx, dy ));

	if( dot( n, p ) > 0.0 )
		n = -n; // towards the eye

	// tangent frame turned by the 4x4 pattern
	float angle = float(( pixel.x & 3 ) * 4 + ( pixel.y & 3 )) * ( 6.2831853 / 16.0 );
	vec3 up = abs( n.y ) < 0.99 ? vec3( 0.0, 1.0, 0.0 ) : vec3( 1.0, 0.0, 0.0 );
	vec3 t = normalize( cross( up, n ));
	vec3 b = cross( n, t );
	float ca = cos( angle ), sa = sin( angle );
	vec3 t2 = t * ca + b * sa;
	vec3 b2 = b * ca - t * sa;

	float radius = pc.params2.x;
	float occlusion = 0.0;

	for( int i = 0; i < NUM_SAMPLES; i++ )
	{
		// golden angle spiral over the hemisphere, denser near the point
		float fi = float( i ) + 0.5;
		float cos_theta = 1.0 - fi / float( NUM_SAMPLES );
		float sin_theta = sqrt( 1.0 - cos_theta * cos_theta );
		float phi = fi * 2.3999632;
		vec3 dir = t2 * ( cos( phi ) * sin_theta ) + b2 * ( sin( phi ) * sin_theta ) + n * cos_theta;
		float scale = mix( 0.15, 1.0, ( fi / float( NUM_SAMPLES )) * ( fi / float( NUM_SAMPLES )));
		vec3 s = p + dir * radius * scale;

		if( s.z <= pc.params.x )
			continue;

		vec2 spixel = ProjectToPixel( s );
		if( any( lessThan( spixel, vec2( pc.rect.xy ))) || any( greaterThanEqual( spixel, vec2( pc.rect.xy + pc.rect.zw ))))
			continue;

		float scene_z = EyeDepthAt( spixel );
		float range = smoothstep( 0.0, 1.0, radius / max( abs( p.z - scene_z ), 1e-3 ));

		if( scene_z > 0.0 && scene_z < s.z - 0.5 )
			occlusion += range;
	}

	float ao = 1.0 - pc.params2.y * occlusion / float( NUM_SAMPLES );
	imageStore( out_ao, pixel, vec4( clamp( ao, 0.0, 1.0 )));
}
