#version 460
#extension GL_GOOGLE_include_directive : require

// the accumulated sun shadows of rt_shadows.comp averaged over 3x3 pixels at
// the same eye distance: the penumbra of a small sun is a few pixels wide
//
// inputs: shadow history, depth
// output: hidden part of the sun (r), 1 where a shadow can fall (a)

layout( local_size_x = 8, local_size_y = 8 ) in;

#include "rtfx_common.glsl"

layout( set = 1, binding = 2, rgba16f ) uniform writeonly image2D outputs[2];

void main()
{
	rtfx_params_r p = rtfx_params_r( pc.params );

	if( any( greaterThanEqual( gl_GlobalInvocationID.xy, uvec2( p.rect.zw ))))
		return;

	ivec2 pixel = ivec2( gl_GlobalInvocationID.xy ) + p.rect.xy;
	vec4 centre = texelFetch( inputs[0], pixel, 0 );

	if( centre.a <= 0.0 )
	{
		imageStore( outputs[0], pixel, vec4( 0.0 ));
		return;
	}

	float z = EyeDepth( p, texelFetch( inputs[1], pixel, 0 ).r );
	float sum = 0.0, weight = 0.0;

	for( int y = -1; y <= 1; y++ )
	{
		for( int x = -1; x <= 1; x++ )
		{
			ivec2 q = clamp( pixel + ivec2( x, y ), p.rect.xy, p.rect.xy + p.rect.zw - 1 );
			vec4 s = texelFetch( inputs[0], q, 0 );

			if( s.a <= 0.0 )
				continue;

			float zs = EyeDepth( p, texelFetch( inputs[1], q, 0 ).r );
			float w = exp( -abs( zs - z ) / ( 0.5 + 0.01 * z )) * ( 2.0 - 0.5 * float( abs( x ) + abs( y ))) * s.y;

			sum += s.x * w;
			weight += w;
		}
	}

	imageStore( outputs[0], pixel, vec4( weight > 0.0 ? sum / weight : centre.x, 0.0, 0.0, 1.0 ));
}
