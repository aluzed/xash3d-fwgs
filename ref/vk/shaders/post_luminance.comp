#version 450
#extension GL_GOOGLE_include_directive : require

// sum of log2 luminance over 32x32 pixel tiles of the view, each thread
// reading the bilinear average of a 4x4 block's centre 2x2
//
// iparams.x: groups across

layout( local_size_x = 8, local_size_y = 8 ) in;

#include "post_common.glsl"
#include "post_exposure_common.glsl"

shared vec2 partial[64];

void main()
{
	ivec2 block = ivec2( gl_GlobalInvocationID.xy ) * 4;
	vec2 sum = vec2( 0.0 );

	if( all( lessThan( block, pc.rect.zw )))
	{
		vec2 centre = vec2( pc.rect.xy + block ) + 2.0;
		vec3 color = textureLod( inputs[0], centre * pc.texel.xy, 0.0 ).rgb;
		sum = vec2( log2( Luminance( color ) + 1e-4 ), 1.0 );
	}

	partial[gl_LocalInvocationIndex] = sum;
	barrier();

	for( uint step = 32; step > 0; step >>= 1 )
	{
		if( gl_LocalInvocationIndex < step )
			partial[gl_LocalInvocationIndex] += partial[gl_LocalInvocationIndex + step];
		barrier();
	}

	if( gl_LocalInvocationIndex == 0 )
		exposure.sums[gl_WorkGroupID.y * uint( pc.iparams.x ) + gl_WorkGroupID.x] = partial[0];
}
