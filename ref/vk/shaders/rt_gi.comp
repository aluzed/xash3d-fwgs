#version 460
#extension GL_GOOGLE_include_directive : require

// ray traced lighting of the lightmapped surfaces (026), per pixel of the
// view, in R_BuildLightMap's 10 bit light units, what rt_effects.comp puts
// in place of the lightmap's:
//
//   static     the lights without a style of the pixel's grid cell, one
//              picked by its unshadowed light among them (resampled
//              importance sampling), with one shadow ray; and one bounce:
//              a ray in the normal's hemisphere, the surface it hits lit
//              by its lightmap (the bake's light, bounces included) times
//              its texture. Accumulated over the frames where the surface
//              stays (the occlusion history knows how far it was).
//   dynamic    the sun (movevars) and the styled lights of the cell, each
//              with its shadow ray, every frame: no noise, and lightstyles
//              animate. Studio models cast shadows in both.
//
// inputs: depth, previous occlusion history, previous lighting history
// outputs: 0 lighting history (static rgb, frames), 1 dynamic (rgb, packed normal)

layout( local_size_x = 8, local_size_y = 8 ) in;

#include "rtfx_common.glsl"

layout( set = 1, binding = 2, rgba16f ) uniform image2D history_out;
layout( set = 1, binding = 3, rgba32f ) uniform image2D dynamic_out;

#define MAX_FRAMES 32.0


// what a bounce ray finds, lit as baked; the sky gives a part of the sun's
// colour, the diffuse sky light of the compilers
vec3 BounceLight( rtfx_params_r p, rt_scene_r scene, vec3 origin, vec3 dir )
{
	rt_hit_s hit;
	int instance;
	float t;

	if( !RTTraceSkip( tlas, scene, origin, dir, 0.0, 65536.0, BLOCKERS, RT_SKIP_NONE, hit, instance, t ))
		return scene.sun_color.rgb * ( p.gi.w * ToLight( scene ));

	// the compiler's reflectivity: the texture's colour as it is stored
	vec3 albedo = hit.texture > 0 ? textureLod( textures[nonuniformEXT( hit.texture )], hit.uv, 2.0 ).rgb : vec3( 0.5 );
	vec3 texel = hit.kind == RT_KIND_STUDIO ? hit.color.rgb
		: hit.lightmap > 0 ? textureLod( textures[nonuniformEXT( hit.lightmap )], hit.lightuv, 0.0 ).rgb : vec3( 0.0 );

	return albedo * vec3( RTTexelToLight( scene, texel.r ), RTTexelToLight( scene, texel.g ), RTTexelToLight( scene, texel.b ));
}

void main()
{
	rtfx_params_r p = rtfx_params_r( pc.params );
	rt_scene_r scene = rt_scene_r( pc.scene );

	if( any( greaterThanEqual( gl_GlobalInvocationID.xy, uvec2( p.rect.zw ))))
		return;

	ivec2 pixel = ivec2( gl_GlobalInvocationID.xy ) + p.rect.xy;
	vec2 uv = ( vec2( gl_GlobalInvocationID.xy ) + 0.5 ) / vec2( p.rect.zw );
	float raster = EyeDepth( p, texelFetch( inputs[0], pixel, 0 ).r );
	vec3 dir;
	rt_hit_s hit;
	int instance;
	float t;

	imageStore( history_out, pixel, vec4( 0.0 ));
	imageStore( dynamic_out, pixel, vec4( 0.0 ));

	if( !PrimaryHit( p, scene, pixel, uv, raster, dir, hit, instance, t ) || hit.kind != RT_KIND_BRUSH
		|| hit.lightmap <= 0 || ( hit.flags & RT_SURF_WATER ) != 0 || scene.lightgrid == 0 )
		return;

	rt_instance_s inst = rt_instances_r( scene.instances ).v[instance];
	if(( inst.flags & RT_INST_VIEWMODEL ) != 0 )
		return;

	rt_lightgrid_r grid = rt_lightgrid_r( scene.lightgrid );
	rt_uints_r indices = rt_uints_r( scene.lightgrid + grid.offsets.y );
	rt_glights_r lights = rt_glights_r( scene.lightgrid + grid.offsets.z );
	vec3 pos = hit.position, n = hit.normal;
	vec3 origin = pos + n * 0.5;
	// the cell of a point a little around: over the frames, no edges between cells
	vec2 jr = Random2( pixel, p.misc.y, 31u );
	vec3 jitter = ( vec3( jr, fract( jr.x * 7.31 + jr.y * 3.17 )) - 0.5 ) * grid.mins.w;
	uvec3 cell = GridCell( grid, pos + jitter );
	uvec3 dyn_cell = GridCell( grid, pos );
	float to_light = ToLight( scene );
	vec3 to;
	float dist;

	// static lights: one picked by what it would give, weighted back
	vec3 static_light = vec3( 0.0 );
	{
		// picked by their light without the texture's colour, which only the
		// picked one reads: the weights are only the odds of the pick
		float total = 0.0, picked_w = 0.0;
		uint picked = 0xffffffffu, salt = 0u;

		for( uint i = 0u; i < cell.y; i++ )
		{
			uint index = indices.v[cell.x + i];
			float w = Luminance( GridLight( lights.v[index], pos, n, false, to, dist ));

			if( w <= 0.0 )
				continue;

			total += w;
			if( Random2( pixel, p.misc.y, 101u + salt++ ).x * total < w )
			{
				picked = index;
				picked_w = w;
			}
		}

		if( picked != 0xffffffffu )
		{
			vec3 c = GridLight( lights.v[picked], pos, n, true, to, dist );

			if( !RTOccluded( tlas, scene, origin, to, max( dist - 2.0, 0.0 ), BLOCKERS, inst.entity ))
				static_light = c * ( total / picked_w ) * to_light;
		}
	}

	// one bounce
	vec3 bounce = p.gi.z > 0.0 ? BounceLight( p, scene, origin, CosineDirection( n, Random2( pixel, p.misc.y, 7u ))) * p.gi.z : vec3( 0.0 );
	vec3 sample_light = static_light + bounce;

	// the same surface in the previous frame
	vec4 history = vec4( sample_light, 1.0 );
	if( pc.iparams.x != 0 ) // a lighting history of the previous frame
	{
		vec4 clip = p.prev_view_proj * vec4( pos, 1.0 );
		vec2 prev = vec2( clip.x / clip.w * 0.5 + 0.5, 0.5 - clip.y / clip.w * 0.5 );

		if( clip.w > 0.0 && all( greaterThanEqual( prev, vec2( 0.0 ))) && all( lessThan( prev, vec2( 1.0 ))))
		{
			ivec2 prev_pixel = ivec2( prev * vec2( p.rect.zw )) + p.rect.xy;
			vec4 prev_ao = texelFetch( inputs[1], prev_pixel, 0 );
			vec4 h = texelFetch( inputs[2], prev_pixel, 0 );
			float luma = Luminance( textureLod( textures[nonuniformEXT( hit.lightmap )], hit.lightuv, 0.0 ).rgb );

			// the same surface, under the same light: a lightstyle that
			// changed its lightmap changes the bounces too, start over
			if( h.a > 0.0 && prev_ao.z > 0.0 && abs( prev_ao.z - length( pos - p.prev_eye.xyz )) < 1.0 + 0.03 * prev_ao.z
				&& abs( prev_ao.w - luma ) < 0.02 + 0.1 * max( luma, prev_ao.w ))
			{
				float frames = min( h.a + 1.0, MAX_FRAMES );
				history = vec4( mix( h.rgb, sample_light, 1.0 / frames ), frames );
			}
		}
	}

	imageStore( history_out, pixel, history );

	// the sun and the styled lights, every frame
	vec3 dynamic = vec3( 0.0 );
	float cos_sun = dot( n, scene.sun_dir.xyz );
	if( cos_sun > 0.0 && dot( scene.sun_color.rgb, vec3( 1.0 )) > 0.0
		&& !RTOccluded( tlas, scene, origin, scene.sun_dir.xyz, 16384.0, BLOCKERS, inst.entity ))
		dynamic += scene.sun_color.rgb * ( cos_sun * p.shadow.x * to_light );

	for( uint i = 0u; i < dyn_cell.z; i++ )
	{
		rt_glight_s l = lights.v[indices.v[dyn_cell.x + dyn_cell.y + i]];
		float style = StyleValue( p, l.style );
		vec3 c = GridLight( l, pos, n, true, to, dist ) * style;

		// a light that gives too little isn't worth its ray
		if( Luminance( c ) > 2.0 && !RTOccluded( tlas, scene, origin, to, max( dist - 2.0, 0.0 ), BLOCKERS, inst.entity ))
			dynamic += c * to_light;
	}

	imageStore( dynamic_out, pixel, vec4( dynamic, PackNormal( n )));
}
