#version 450
#extension GL_GOOGLE_include_directive : require

// FXAA, after the quality preset of Timothy Lottes' FXAA 3.11: finds the
// edge through each pixel, walks along it to both ends, and blends with
// the neighbour across it by how far the pixel is from the nearer end

layout( local_size_x = 8, local_size_y = 8 ) in;

#include "post_common.glsl"

layout( set = 0, binding = 1, rgba8 ) uniform writeonly image2D out_ldr;

#define EDGE_THRESHOLD     0.125
#define EDGE_THRESHOLD_MIN 0.0312
#define SUBPIX             0.75
#define SEARCH_STEPS       10

const float search_step[SEARCH_STEPS] = float[]( 1.0, 1.0, 1.0, 1.0, 1.5, 2.0, 2.0, 2.0, 4.0, 8.0 );

vec3 Fetch( vec2 uv )
{
	return textureLod( inputs[0], clamp( uv, pc.src_rect.xy, pc.src_rect.zw ), 0.0 ).rgb;
}

float Luma( vec2 uv )
{
	return sqrt( Luminance( Fetch( uv )));
}

void main()
{
	ivec2 pixel;

	if( !PostPixel( pixel ))
		return;

	vec2 uv = ( vec2( pixel ) + 0.5 ) * pc.texel.xy;
	vec2 t = pc.texel.xy;
	vec3 centre_color = Fetch( uv );
	float m = sqrt( Luminance( centre_color ));
	float n = Luma( uv + vec2( 0.0, -t.y )), s = Luma( uv + vec2( 0.0, t.y ));
	float w = Luma( uv + vec2( -t.x, 0.0 )), e = Luma( uv + vec2( t.x, 0.0 ));

	float range_max = max( m, max( max( n, s ), max( w, e )));
	float range_min = min( m, min( min( n, s ), min( w, e )));
	float range = range_max - range_min;

	if( range < max( EDGE_THRESHOLD_MIN, range_max * EDGE_THRESHOLD ))
	{
		imageStore( out_ldr, pixel, vec4( centre_color, 1.0 ));
		return;
	}

	float nw = Luma( uv + vec2( -t.x, -t.y )), ne = Luma( uv + vec2( t.x, -t.y ));
	float sw = Luma( uv + vec2( -t.x, t.y )), se = Luma( uv + vec2( t.x, t.y ));

	// sub-pixel aliasing amount
	float average = ( 2.0 * ( n + s + w + e ) + nw + ne + sw + se ) / 12.0;
	float subpix = clamp( abs( average - m ) / range, 0.0, 1.0 );
	subpix = smoothstep( 0.0, 1.0, subpix );
	subpix = subpix * subpix * SUBPIX;

	// horizontal or vertical edge
	float edge_h = abs( nw + sw - 2.0 * w ) + 2.0 * abs( n + s - 2.0 * m ) + abs( ne + se - 2.0 * e );
	float edge_v = abs( nw + ne - 2.0 * n ) + 2.0 * abs( w + e - 2.0 * m ) + abs( sw + se - 2.0 * s );
	bool horizontal = edge_h >= edge_v;

	float luma1 = horizontal ? n : w;
	float luma2 = horizontal ? s : e;
	float gradient1 = abs( luma1 - m ), gradient2 = abs( luma2 - m );
	bool steeper1 = gradient1 >= gradient2;
	float gradient = 0.25 * max( gradient1, gradient2 );
	float step_len = horizontal ? t.y : t.x;
	float luma_local = 0.5 * (( steeper1 ? luma1 : luma2 ) + m );

	if( steeper1 )
		step_len = -step_len;

	// half a pixel towards the edge, then along it both ways
	vec2 edge_uv = uv;
	if( horizontal )
		edge_uv.y += step_len * 0.5;
	else edge_uv.x += step_len * 0.5;

	vec2 dir = horizontal ? vec2( t.x, 0.0 ) : vec2( 0.0, t.y );
	vec2 uv1 = edge_uv - dir, uv2 = edge_uv + dir;
	float end1 = Luma( uv1 ) - luma_local, end2 = Luma( uv2 ) - luma_local;
	bool done1 = abs( end1 ) >= gradient, done2 = abs( end2 ) >= gradient;

	for( int i = 1; i < SEARCH_STEPS && !( done1 && done2 ); i++ )
	{
		if( !done1 )
		{
			uv1 -= dir * search_step[i];
			end1 = Luma( uv1 ) - luma_local;
			done1 = abs( end1 ) >= gradient;
		}

		if( !done2 )
		{
			uv2 += dir * search_step[i];
			end2 = Luma( uv2 ) - luma_local;
			done2 = abs( end2 ) >= gradient;
		}
	}

	float dist1 = horizontal ? uv.x - uv1.x : uv.y - uv1.y;
	float dist2 = horizontal ? uv2.x - uv.x : uv2.y - uv.y;
	bool nearer1 = dist1 < dist2;
	float dist = min( dist1, dist2 );
	float length_total = dist1 + dist2;

	// only blend when the pixel is on the side of the edge that ends there
	bool centre_smaller = m < luma_local;
	bool correct = (( nearer1 ? end1 : end2 ) < 0.0 ) != centre_smaller;
	float offset = correct ? 0.5 - dist / length_total : 0.0;
	offset = max( offset, subpix );

	vec2 final_uv = uv;
	if( horizontal )
		final_uv.y += offset * step_len;
	else final_uv.x += offset * step_len;

	imageStore( out_ldr, pixel, vec4( Fetch( final_uv ), 1.0 ));
}
