#version 450
#extension GL_GOOGLE_include_directive : require

// contrast adaptive sharpening (AMD FidelityFX CAS, without its scaling):
// sharpens less where the neighbourhood is already close to black or white
//
// params.x: sharpness, 0 to 1

layout( local_size_x = 8, local_size_y = 8 ) in;

#include "post_common.glsl"

layout( set = 0, binding = 1, rgba8 ) uniform writeonly image2D out_ldr;

vec3 Fetch( ivec2 p )
{
	return texelFetch( inputs[0], clamp( p, pc.rect.xy, pc.rect.xy + pc.rect.zw - 1 ), 0 ).rgb;
}

void main()
{
	ivec2 pixel;

	if( !PostPixel( pixel ))
		return;

	vec3 a = Fetch( pixel + ivec2( -1, -1 )), b = Fetch( pixel + ivec2( 0, -1 )), c = Fetch( pixel + ivec2( 1, -1 ));
	vec3 d = Fetch( pixel + ivec2( -1, 0 )), e = Fetch( pixel ), f = Fetch( pixel + ivec2( 1, 0 ));
	vec3 g = Fetch( pixel + ivec2( -1, 1 )), h = Fetch( pixel + ivec2( 0, 1 )), i = Fetch( pixel + ivec2( 1, 1 ));

	vec3 mn = min( min( min( d, e ), min( f, b )), h );
	vec3 mn2 = min( min( min( mn, a ), min( c, g )), i );
	mn += mn2;

	vec3 mx = max( max( max( d, e ), max( f, b )), h );
	vec3 mx2 = max( max( max( mx, a ), max( c, g )), i );
	mx += mx2;

	vec3 amp = sqrt( clamp( min( mn, 2.0 - mx ) / max( mx, vec3( 1e-5 )), 0.0, 1.0 ));
	vec3 weight = amp * ( -1.0 / mix( 8.0, 5.0, pc.params.x ));
	vec3 color = (( b + d + f + h ) * weight + e ) / ( 1.0 + 4.0 * weight );

	imageStore( out_ldr, pixel, vec4( clamp( color, 0.0, 1.0 ), 1.0 ));
}
