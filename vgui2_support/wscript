#!/usr/bin/env python

def options(opt):
	pass

def configure(conf):
	if conf.env.COMPILER_CXX != 'msvc':
		conf.env.append_unique('CXXFLAGS', ['-fno-exceptions'])

	# the engine loads it by its name, without the lib prefix
	if conf.env.cxxshlib_PATTERN.startswith('lib'):
		conf.env.cxxshlib_PATTERN = conf.env.cxxshlib_PATTERN[3:]

def build(bld):
	bld.shlib(target = 'vgui2_support',
		features = 'cxx',
		source = bld.path.ant_glob(['*.cpp']),
		includes = ['.', '../engine/client/vgui', '../3rdparty/mainui/font'],
		use = ['werror', 'DL'],
		install_path = bld.env.LIBDIR)
